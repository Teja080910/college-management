{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-config": "~54.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "tailwindcss": "^3.4.19"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild --platform android --clean",
    "gradle:apk": "cd android && ./gradlew assembleRelease",
    "apk": "npx expo prebuild --platform android --clean && cd android && ANDROID_HOME=$HOME/Android/Sdk ./gradlew assembleRelease",
    "apk:dev": "npx expo run:android",
    "apk:fast": "cd android && ANDROID_HOME=$HOME/Android/Sdk ./gradlew assembleRelease",
    "clean": "rm -rf android ios && npx expo start --clear"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-native-vector-icons": "^6.4.18",
    "typescript": "~5.9.2"
  }
}
